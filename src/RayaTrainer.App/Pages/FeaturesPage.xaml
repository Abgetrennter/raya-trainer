<UserControl x:Class="RayaTrainer.App.Pages.FeaturesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:RayaTrainer.App.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <TextBlock Text="功能开关" Style="{DynamicResource PageTitle}" />
      <TextBlock Text="常用功能都在这里：点开开关立即生效，也可以按快捷键触发；右键按键徽章可修改快捷键。"
                 Style="{DynamicResource PageSubtitle}" />
      <!-- 游戏内控制台入口提示（P1-5）：入口本身在 Agent 附加时自动开启，这里提供可发现性引导。 -->
      <Border Background="{DynamicResource BrushCardBackground}"
              BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1"
              CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}">
            <Run Text="游戏内控制台" /><Run Text=" · " Foreground="{DynamicResource BrushTextDim}" /><Run Text="进入战局后按 F10 呼出" Foreground="{DynamicResource BrushAccent}" />
          </TextBlock>
          <TextBlock Text="附加到游戏后自动可用：功能开关、选中单位、增援与秘密协议都能在游戏里直接操作；右上角“收起”可缩成屏幕角落的小徽章。改键请到“设置快捷键”页。"
                     TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                     Foreground="{DynamicResource BrushTextDim}" />
        </StackPanel>
      </Border>
      <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
               Tag="搜索功能…"
               Margin="0,0,0,12" FontSize="13" />
      <ctrl:FeaturePresetCard DataContext="{Binding DataContext.FeaturePresetsPanel, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,8" />
      <ItemsControl ItemsSource="{Binding FilteredGroups}" Margin="0,0,0,16">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <ctrl:ActionCard Header="{Binding Name}" IsExpanded="{Binding IsExpanded}" Margin="0,0,0,16">
            <ItemsControl ItemsSource="{Binding Features}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid.Style>
                      <Style TargetType="Grid">
                        <Setter Property="Opacity" Value="1" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                            <Setter Property="Opacity" Value="0.72" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Grid.Style>

                    <TextBlock Text="{Binding DisplayName}"
                               ToolTip="{Binding HelpText}"
                               ToolTipService.InitialShowDelay="250"
                               ToolTipService.ShowDuration="12000"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource BrushTextPrimary}" FontSize="13" />

                    <!-- Money input (shown only on "增加玩家战场资金") -->
                    <TextBox Grid.Column="1" Width="90" Margin="8,0,0,0"

                             Text="{Binding DataContext.MoneyAmountText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{Binding DataContext.MoneyAmountHelpText, RelativeSource={RelativeSource AncestorType=UserControl}}">
                      <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource ParameterInput}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding ParameterKind}" Value="Money">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBox.Style>
                    </TextBox>
                    <!-- Power input (shown only on "无限电力") -->
                    <TextBox Grid.Column="1" Width="90" Margin="8,0,0,0"

                             Text="{Binding DataContext.PowerValueText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{Binding DataContext.PowerValueHelpText, RelativeSource={RelativeSource AncestorType=UserControl}}">
                      <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource ParameterInput}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding ParameterKind}" Value="Power">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBox.Style>
                    </TextBox>
                    <!-- SC Point input (shown only on "无限秘密协议点数") -->
                    <TextBox Grid.Column="1" Width="90" Margin="8,0,0,0"

                             Text="{Binding DataContext.ScPointValueText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{Binding DataContext.ScPointValueHelpText, RelativeSource={RelativeSource AncestorType=UserControl}}">
                      <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource ParameterInput}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding ParameterKind}" Value="ScPoint">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBox.Style>
                    </TextBox>
                    <!-- Veterancy level input (shown only on "生产升星授予") -->
                    <TextBox Grid.Column="1" Width="90" Margin="8,0,0,0"

                             Text="{Binding DataContext.VeterancyLevelText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{Binding DataContext.VeterancyLevelHelpText, RelativeSource={RelativeSource AncestorType=UserControl}}">
                      <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource ParameterInput}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding ParameterKind}" Value="Veterancy">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBox.Style>
                    </TextBox>
                    <!-- Ore-node preset radio group (shown only on “生成矿脉"); 1/3/5/7 = 东北/西北/西南/东南 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center"
                                ToolTip="{Binding DataContext.OreNodeAngleHelpText, RelativeSource={RelativeSource AncestorType=UserControl}}">
                      <StackPanel.Style>
                        <Style TargetType="StackPanel">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding ParameterKind}" Value="OreNode">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </StackPanel.Style>
                      <RadioButton GroupName="OreNodeAngle" Content="东北" FontSize="12" Margin="0,0,10,0"
                                   IsChecked="{Binding DataContext.OreNodePresetIsNortheast, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                      <RadioButton GroupName="OreNodeAngle" Content="西北" FontSize="12" Margin="0,0,10,0"
                                   IsChecked="{Binding DataContext.OreNodePresetIsNorthwest, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                      <RadioButton GroupName="OreNodeAngle" Content="西南" FontSize="12" Margin="0,0,10,0"
                                   IsChecked="{Binding DataContext.OreNodePresetIsSouthwest, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                      <RadioButton GroupName="OreNodeAngle" Content="东南" FontSize="12"
                                   IsChecked="{Binding DataContext.OreNodePresetIsSoutheast, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>

                    <!-- Hotkey badge: 始终可见（无热键时显示占位），右键可跳转设置页改键。 -->
                    <ctrl:KeyBadge Grid.Column="2"
                                   Content="{Binding HotkeyDisplay}"
                                   ToolTip="右键修改快捷键"
                                   VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="28">
                      <ctrl:KeyBadge.ContextMenu>
                        <ContextMenu>
                          <!-- MenuItem 上没有 PlacementTarget 属性，必须从 ContextMenu 祖先取，
                               否则绑定静默失败、菜单点击无效果。 -->
                          <MenuItem Header="修改快捷键…"
                                    Command="{Binding PlacementTarget.DataContext.OpenHotkeySettingsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                      </ctrl:KeyBadge.ContextMenu>
                    </ctrl:KeyBadge>

                    <!-- Toggle / Action / Pulse -->
                    <Grid Grid.Column="3" Margin="14,0,0,0" VerticalAlignment="Center">
                      <ctrl:ToggleSwitch IsChecked="{Binding IsFeatureEnabled, Mode=OneWay}"
                                         Command="{Binding Command}" ToolTip="{Binding HelpText}"
                                         Visibility="{Binding IsToggle, Converter={StaticResource BoolVis}}" />
                      <!-- Action or Pulse button (hidden when IsToggle) -->
                      <Button Content="{Binding ActionText}" Command="{Binding Command}" ToolTip="{Binding HelpText}"
                              Style="{DynamicResource SmallButton}" Padding="12,5" FontSize="12">
                        <Button.Visibility>
                          <Binding Path="IsToggle" Converter="{StaticResource InvBoolVis}" />
                        </Button.Visibility>
                      </Button>
                      <!-- Pulse triggered badge (shown when IsPulseTriggered) -->
                      <Border Background="{DynamicResource BrushSuccess}" CornerRadius="6"
                              Padding="10,5" Visibility="{Binding IsPulseTriggered, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="已触发" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnAccent}" />
                      </Border>
                    </Grid>

                    <!-- Capability: availability is independent from the current toggle/action state. -->
                    <Border Grid.Column="4" CornerRadius="8" Padding="7,2" Margin="12,0,0,0"
                            ToolTip="{Binding CapabilityReason}" VerticalAlignment="Center">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{DynamicResource BrushFactionSovietSoft}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding CapabilityState}" Value="Ready">
                              <Setter Property="Background" Value="{DynamicResource BrushFactionAlliedSoft}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CapabilityState}" Value="Waiting">
                              <Setter Property="Background" Value="{DynamicResource BrushFactionImperialSoft}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding CapabilityLabel}" FontSize="10" FontWeight="SemiBold">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource BrushError}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding CapabilityState}" Value="Ready">
                                <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding CapabilityState}" Value="Waiting">
                                <Setter Property="Foreground" Value="{DynamicResource BrushWarning}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>

                    <!-- Execution status -->
                    <TextBlock Grid.Column="5" Text="{Binding Status}" ToolTip="{Binding HelpText}"
                               VerticalAlignment="Center" Margin="14,0,0,0"
                               FontSize="12" MinWidth="50" TextAlignment="Right">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource BrushTextDim}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFeatureEnabled}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource BrushSuccess}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ctrl:ActionCard>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
