<UserControl x:Class="RayaTrainer.App.Pages.AscensionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- 总览区单项清除小按钮 -->
    <Style x:Key="OverviewClearButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource BrushTextDim}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushHoverBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource BrushError}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,0,16">

      <!-- 工具条：应用 / 还原 / 读回 / 状态 -->
      <Border Style="{DynamicResource ActionCardBorder}">
        <StackPanel>
          <TextBlock Text="属性修改 · 全类型 Modifier 矩阵" FontSize="14" FontWeight="SemiBold"
                     Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,14" />
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="应用"
                    Command="{Binding ApplyCommand}"
                    ToolTip="把三个页签启用的修正行与已生效项合并为整表提交；成功后开关自动复位。"
                    Style="{DynamicResource PrimaryButton}" />
            <Button Grid.Column="1" Content="全部还原"
                    Command="{Binding RestoreCommand}"
                    ToolTip="卸载本页提交的全部修正（三个页签一起清空）。"
                    Style="{DynamicResource DangerButton}" Margin="10,0,0,0" />
            <Button Grid.Column="2" Content="读回状态"
                    Command="{Binding RefreshActiveStateCommand}"
                    ToolTip="从游戏读回当前实际生效的策略表，刷新总览与各行“已生效”标记（战局更换后建议先读回对账）。"
                    Margin="10,0,0,0" />
            <TextBlock Grid.Column="3" Text="{Binding StatusText}" VerticalAlignment="Center"
                       Foreground="{DynamicResource BrushTextSecondary}" FontSize="12"
                       Margin="14,0,0,0" TextWrapping="Wrap" />
          </Grid>
          <TextBlock Foreground="{DynamicResource BrushTextDim}" FontSize="12" TextWrapping="Wrap"
                     Text="三个页签各一份独立矩阵：同一属性可同时“我方强化 ×2”与“敌方削弱 ×0.5”，应用时与已生效项合并为整表提交，成功后开关自动复位，生效项保留在下方总览区；再次打开开关并应用＝追加或覆盖同属性修正。范围语义：选中＝提交时一次性应用，不进入生效总览，且与常驻范围互斥；全部 / 新注册＝常驻生效，可叠加多选，出现在总览区并可单独清除。倍率自动量化到位权模板（×1/128 ~ ×128）；增强直接应用倍率，削弱应用倍率的倒数（削弱 ×2 = ×0.5）。" />
        </StackPanel>
      </Border>

      <!-- 生效中修改 · 总览：按侧分泳道，单项 ✕ 立即清除 -->
      <Border Style="{DynamicResource ActionCardBorder}">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="生效中修改" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextPrimary}" />
            <TextBlock Text="（常驻范围；✕ 立即清除单项，清空按钮清除整侧）" FontSize="11"
                       Foreground="{DynamicResource BrushTextDim}" Margin="8,0,0,0"
                       VerticalAlignment="Center" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Sides}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="3" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border CornerRadius="8" Padding="12" Margin="0,0,10,0" BorderThickness="1">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{DynamicResource BrushFactionAlliedSoft}" />
                      <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Side}" Value="Enemy">
                          <Setter Property="Background" Value="{DynamicResource BrushFactionSovietSoft}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Side}" Value="All">
                          <Setter Property="Background" Value="{DynamicResource BrushFactionImperialSoft}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel>
                    <Grid Margin="0,0,0,8">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ActiveCount, StringFormat= · {0} 项生效}" FontSize="11"
                                   Foreground="{DynamicResource BrushTextDim}" VerticalAlignment="Center" />
                      </StackPanel>
                      <Button HorizontalAlignment="Right"
                              Content="{Binding Title, StringFormat=清空{0}}"
                              Command="{Binding ClearSideCommand}"
                              Style="{StaticResource OverviewClearButton}"
                              ToolTip="清除该侧全部生效项，并重新提交其余生效项。" />
                    </Grid>
                    <Grid>
                      <TextBlock Text="无生效修改" FontSize="12"
                                 Foreground="{DynamicResource BrushTextDisabled}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding ActiveCount}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <ItemsControl ItemsSource="{Binding ActiveItems}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Background="{DynamicResource BrushInputBackground}"
                                    BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1"
                                    CornerRadius="12" Padding="10,4" Margin="0,0,0,6">
                              <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                           Foreground="{DynamicResource BrushTextPrimary}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ValueText}" FontSize="11"
                                           Foreground="{DynamicResource BrushSuccess}"
                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ScopeText}" FontSize="10"
                                           Foreground="{DynamicResource BrushTextDim}"
                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                                <Button Content="✕" Command="{Binding ClearCommand}"
                                        Style="{StaticResource OverviewClearButton}" Margin="6,0,0,0"
                                        ToolTip="立即清除此项：重新提交不含该行的剩余策略表。" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- 配置矩阵：预设（页签上方）＋ 三页签 ＋ 行卡片 -->
      <Border Style="{DynamicResource ActionCardBorder}">
        <StackPanel>

          <!-- 预设：按当前页签侧保存 / 装载；装载不会自动执行 -->
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="预设" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,10,0" />
            <TextBox Grid.Column="1"
                     Text="{Binding PresetNameText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Margin="0,0,8,0"
                     ToolTip="预设名；保存当前页签矩阵，同名保存会更新原预设" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button Content="保存当前页签" Command="{Binding SavePresetCommand}"
                      Style="{DynamicResource SmallButton}" Padding="12,5" />
              <ComboBox ItemsSource="{Binding Presets}"
                        SelectedItem="{Binding SelectedPreset}"
                        DisplayMemberPath="Name"
                        MinWidth="140" Margin="8,0,0,0" />
              <Button Content="装载" Command="{Binding LoadPresetCommand}"
                      Style="{DynamicResource SmallButton}" Padding="12,5" Margin="4,0,0,0" />
              <Button Content="重命名" Command="{Binding RenamePresetCommand}"
                      Style="{DynamicResource SmallButton}" Padding="12,5" Margin="4,0,0,0" />
              <Button Content="删除" Command="{Binding DeletePresetCommand}"
                      Style="{DynamicResource SmallButton}" Padding="12,5" Margin="4,0,0,0" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding PresetStatusText}" FontSize="12"
                     Foreground="{DynamicResource BrushTextDim}" FontStyle="Italic"
                     Margin="0,0,0,10" TextWrapping="Wrap" />

          <!-- 页签：我方 / 敌方 / 全部单位 -->
          <ItemsControl ItemsSource="{Binding Sides}" Margin="0,0,0,14">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <RadioButton Style="{DynamicResource AscensionSideTab}" GroupName="SideTabs"
                             IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,6,0"
                             ToolTip="切换到该侧矩阵；每侧独立配置，应用时合并提交。">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource BrushButtonBackground}" CornerRadius="8"
                            Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding EnabledCount}" FontSize="10"
                                 Foreground="{DynamicResource BrushTextSecondary}" />
                    </Border>
                  </StackPanel>
                </RadioButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- 矩阵面板：每侧一组分组卡片 -->
          <ItemsControl ItemsSource="{Binding Sides}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                  <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,0,0,14">
                          <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                     Foreground="{DynamicResource BrushTextSecondary}" Margin="2,0,0,6" />
                          <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border CornerRadius="8" BorderThickness="1" Padding="12,9" Margin="0,0,0,6">
                                  <Border.Style>
                                    <Style TargetType="Border">
                                      <Setter Property="Background" Value="{DynamicResource BrushInputBackground}" />
                                      <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}" />
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                          <Setter Property="Background" Value="{DynamicResource BrushHoverBackground}" />
                                          <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </Border.Style>
                                  <Grid>
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="44" />
                                      <ColumnDefinition Width="190" />
                                      <ColumnDefinition Width="Auto" />
                                      <ColumnDefinition Width="74" />
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Style="{DynamicResource AscensionEnableSwitch}"
                                              IsChecked="{Binding IsEnabled}"
                                              ToolTip="打开后该行成为待应用项，参与“应用”；提交成功后开关自动复位。" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                      <TextBlock Text="{Binding Entry.DisplayName}" FontSize="13"
                                                 Foreground="{DynamicResource BrushTextPrimary}" />
                                      <TextBlock Text="{Binding Entry.EnumName}" FontSize="10"
                                                 Foreground="{DynamicResource BrushTextDim}" />
                                      <TextBlock Text="{Binding ActiveNote}" FontSize="10"
                                                 Foreground="{DynamicResource BrushSuccess}"
                                                 ToolTip="该侧该类型当前在游戏内生效的模板值（来源：最近一次应用或读回）。" />
                                    </StackPanel>

                                    <Border Grid.Column="2" Background="{DynamicResource BrushButtonBackground}"
                                            CornerRadius="6" Padding="2" VerticalAlignment="Center">
                                      <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="▲ 增强" Style="{DynamicResource AscensionSegmentUp}"
                                                     IsChecked="{Binding IsUp, Mode=TwoWay}"
                                                     ToolTip="直接应用倍率。" />
                                        <RadioButton Content="▼ 削弱" Style="{DynamicResource AscensionSegmentDown}"
                                                     IsChecked="{Binding IsDown, Mode=TwoWay}"
                                                     ToolTip="应用倍率的倒数（削弱 ×2 = ×0.5）。" />
                                      </StackPanel>
                                    </Border>

                                    <TextBox Grid.Column="3"
                                             Text="{Binding MultiplierText, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center" Margin="10,0,0,0"
                                             ToolTip="任意倍率：如 3、1.5、0.5、50%；自动量化到位权模板。" />

                                    <TextBlock Grid.Column="4" Text="{Binding QuantizationText}"
                                               VerticalAlignment="Center" FontSize="11"
                                               Foreground="{DynamicResource BrushTextSecondary}"
                                               TextTrimming="CharacterEllipsis" Margin="10,0,10,0"
                                               ToolTip="{Binding QuantizationText}" />

                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                      <CheckBox Content="选中" Style="{DynamicResource AscensionScopeChip}"
                                                IsChecked="{Binding ScopeSelected}"
                                                ToolTip="一次性：提交时游戏内选中的单位；不进入生效总览，且与常驻范围互斥。" />
                                      <CheckBox Content="全部" Style="{DynamicResource AscensionScopeChip}"
                                                IsChecked="{Binding ScopeAll}" Margin="6,0,0,0"
                                                ToolTip="常驻：按该页签阵营扫描现有单位；与“选中”互斥。" />
                                      <CheckBox Content="新注册" Style="{DynamicResource AscensionScopeChip}"
                                                IsChecked="{Binding ScopeNewRegistered}" Margin="6,0,0,0"
                                                ToolTip="常驻：之后新出生/建造的单位自动挂载，直到清除该行；与“选中”互斥。" />
                                    </StackPanel>
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
