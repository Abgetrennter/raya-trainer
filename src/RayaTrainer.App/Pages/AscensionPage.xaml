<UserControl x:Class="RayaTrainer.App.Pages.AscensionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <!-- 应用没有 CheckBox/RadioButton 的全局隐式样式，默认前景走系统色不跟随应用主题；页内补齐。 -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,0,16">

      <!-- 工具条：阵营过滤 / 应用 / 还原 / 状态 -->
      <Border Style="{DynamicResource ActionCardBorder}">
        <StackPanel>
          <TextBlock Text="属性修改 · 全类型 Modifier 矩阵" FontSize="14" FontWeight="SemiBold"
                     Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,14" />
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="阵营过滤" VerticalAlignment="Center"
                       Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,10,0" FontSize="13" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding FactionFilterOptions}"
                      SelectedItem="{Binding FactionFilter}"
                      ToolTip="“全部单位”范围按此阵营过滤；“选中单位”与“新注册”不受影响。" />
            <Button Grid.Column="2" Content="应用"
                    Command="{Binding ApplyCommand}"
                    ToolTip="把勾选的修正行提交执行（阶段 2 接入执行层；当前只做期望态校验）。"
                    Style="{DynamicResource PrimaryButton}" Margin="14,0,0,0" />
            <Button Grid.Column="3" Content="全部还原"
                    Command="{Binding RestoreCommand}"
                    ToolTip="清空全部勾选并还原已应用的修正（还原指令阶段 2 接入）。"
                    Style="{DynamicResource DangerButton}" Margin="10,0,0,0" />
            <Button Grid.Column="4" Content="读回状态"
                    Command="{Binding RefreshActiveStateCommand}"
                    ToolTip="从 Agent 读回当前实际生效的属性修改策略表，刷新各行“已生效”标记（战局更换后建议先读回对账）。"
                    Margin="10,0,0,0" />
            <TextBlock Grid.Column="5" Text="{Binding StatusText}" VerticalAlignment="Center"
                       Foreground="{DynamicResource BrushTextSecondary}" FontSize="12"
                       Margin="14,0,0,0" TextWrapping="Wrap" />
          </Grid>
          <TextBlock Foreground="{DynamicResource BrushTextDim}" FontSize="12" TextWrapping="Wrap"
                     Text="每行可任意倍率输入，自动量化到位权模板（上限 ×128，下限 ×1/128）。Up 直接应用倍率；Down 应用倍率的倒数（Down ×2 = ×0.5，Down ×4 = ×0.25）。三种范围可叠加：选中=提交时游戏内选中单位；全部=按阵营扫现有单位；新注册=常驻策略，之后新出生的单位自动挂载，直到关闭该行。" />
        </StackPanel>
      </Border>

      <!-- 属性预设：只恢复矩阵表单，仍由用户点击“应用”后执行。 -->
      <Border Style="{DynamicResource ActionCardBorder}">
        <StackPanel>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="属性预设" FontWeight="SemiBold" FontSize="14"
                         Foreground="{DynamicResource BrushTextPrimary}" />
              <TextBlock Text="（保存阵营、启用项、方向、倍率与作用范围）" FontSize="11"
                         Foreground="{DynamicResource BrushTextDim}" Margin="8,0,0,0"
                         VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <ComboBox ItemsSource="{Binding Presets}"
                        SelectedItem="{Binding SelectedPreset}"
                        DisplayMemberPath="Name"
                        MinWidth="140" Margin="0,0,8,0" />
              <Button Content="装载" Command="{Binding LoadPresetCommand}"
                      Style="{DynamicResource SmallButton}" Padding="12,5" Margin="4,0,0,0" />
              <Button Content="删除" Command="{Binding DeletePresetCommand}"
                      Style="{DynamicResource SmallButton}" Padding="12,5" Margin="4,0,0,0" />
            </StackPanel>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding PresetNameText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Margin="0,0,8,0"
                     ToolTip="输入预设名；同名保存会更新原预设" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Content="保存当前" Command="{Binding SavePresetCommand}"
                      Style="{DynamicResource SmallButton}" Padding="12,5" Margin="4,0,0,0" />
              <Button Content="重命名" Command="{Binding RenamePresetCommand}"
                      Style="{DynamicResource SmallButton}" Padding="12,5" Margin="4,0,0,0" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding PresetStatusText}" FontSize="12"
                     Foreground="{DynamicResource BrushTextDim}" FontStyle="Italic"
                     Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- 矩阵分组 -->
      <ItemsControl ItemsSource="{Binding Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{DynamicResource ActionCardBorder}">
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,10" />

                <!-- 表头 -->
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="启用" Foreground="{DynamicResource BrushTextDim}" FontSize="11" />
                  <TextBlock Grid.Column="1" Text="类型" Foreground="{DynamicResource BrushTextDim}" FontSize="11" />
                  <TextBlock Grid.Column="2" Text="方向" Foreground="{DynamicResource BrushTextDim}" FontSize="11" />
                  <TextBlock Grid.Column="3" Text="倍率" Foreground="{DynamicResource BrushTextDim}" FontSize="11" />
                  <TextBlock Grid.Column="4" Text="量化预览" Foreground="{DynamicResource BrushTextDim}" FontSize="11" />
                  <TextBlock Grid.Column="5" Text="作用范围（可多选）" Foreground="{DynamicResource BrushTextDim}" FontSize="11" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="34" />
                          <ColumnDefinition Width="190" />
                          <ColumnDefinition Width="110" />
                          <ColumnDefinition Width="80" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>

                        <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"
                                  ToolTip="勾选后该行参与“应用”。" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Entry.DisplayName}" FontSize="13"
                                     Foreground="{DynamicResource BrushTextPrimary}" />
                          <TextBlock Text="{Binding Entry.EnumName}" FontSize="10"
                                     Foreground="{DynamicResource BrushTextDim}" />
                          <TextBlock Text="{Binding ActiveNote}" FontSize="10"
                                     Foreground="{DynamicResource BrushSuccess}"
                                     ToolTip="该类型当前在游戏内生效的模板值（来源：最近一次应用或读回）。" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                          <RadioButton Content="Up" IsChecked="{Binding IsUp, Mode=TwoWay}"
                                       VerticalAlignment="Center" FontSize="12" />
                          <RadioButton Content="Down" IsChecked="{Binding IsDown, Mode=TwoWay}"
                                       VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0" />
                        </StackPanel>

                        <TextBox Grid.Column="3"
                                 Text="{Binding MultiplierText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"
                                 ToolTip="任意倍率：如 3、1.5、0.5、50%；自动量化到位权模板。" />

                        <TextBlock Grid.Column="4" Text="{Binding QuantizationText}"
                                   VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   TextTrimming="CharacterEllipsis" Margin="10,0,10,0"
                                   ToolTip="{Binding QuantizationText}" />

                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                          <CheckBox Content="选中" IsChecked="{Binding ScopeSelected}" FontSize="12"
                                    ToolTip="提交时游戏内选中的单位（Captured ObjectID 路径）。" />
                          <CheckBox Content="全部" IsChecked="{Binding ScopeAll}" FontSize="12"
                                    Margin="10,0,0,0"
                                    ToolTip="按顶部阵营过滤扫描现有单位。" />
                          <CheckBox Content="新注册" IsChecked="{Binding ScopeNewRegistered}" FontSize="12"
                                    Margin="10,0,0,0"
                                    ToolTip="常驻策略：之后新出生/建造的单位自动挂载，直到关闭该行。" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
  </ScrollViewer>
</UserControl>
