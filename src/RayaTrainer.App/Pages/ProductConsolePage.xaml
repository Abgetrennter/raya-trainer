<UserControl x:Class="RayaTrainer.App.Pages.ProductConsolePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <DockPanel>
        <TextBlock Text="产品控制台" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
        <Button DockPanel.Dock="Right" Content="刷新状态" Command="{Binding RefreshCommand}"
                Style="{DynamicResource PrimaryButton}" Padding="18,8" />
      </DockPanel>
      <TextBlock Text="本页用于查看产品控制协商结果、目标意图与分层结果，并从产品目录中下发产品指令。每个产品的绑定/范围/复用与参数均来自其声明定义。"
                 Margin="0,4,0,12" TextWrapping="Wrap"
                 Foreground="{DynamicResource BrushTextSecondary}" />
      <TextBlock Text="{Binding StatusText}" Margin="0,0,0,4" TextWrapping="Wrap"
                 Foreground="{DynamicResource BrushTextSecondary}" />
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="360" />
      </Grid.ColumnDefinitions>
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Background="{DynamicResource BrushCardBackground}" BorderBrush="{DynamicResource BrushBorder}"
                  BorderThickness="1" CornerRadius="8" Padding="14">
            <StackPanel>
              <TextBlock Text="协商与诊断" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
              <TextBlock Text="{Binding NegotiationSummary}" Margin="0,6,0,8" TextWrapping="Wrap"
                         Foreground="{DynamicResource BrushTextSecondary}" />
              <TextBlock Text="{Binding CapabilityDetails}" Margin="0,2" TextWrapping="Wrap"
                         Foreground="{DynamicResource BrushTextSecondary}" />
              <TextBlock Text="{Binding SchemaDetails}" Margin="0,2" TextWrapping="Wrap"
                         Foreground="{DynamicResource BrushTextSecondary}" />
              <TextBlock Text="{Binding LifecycleDetails}" Margin="0,2" TextWrapping="Wrap"
                         Foreground="{DynamicResource BrushTextSecondary}" />
              <TextBlock Text="{Binding SnapshotDetails}" Margin="0,2" TextWrapping="Wrap"
                         Foreground="{DynamicResource BrushTextSecondary}" />
              <TextBlock Text="{Binding DesiredSummary}" Margin="0,2" TextWrapping="Wrap"
                         Foreground="{DynamicResource BrushTextSecondary}" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource BrushCardBackground}" BorderBrush="{DynamicResource BrushBorder}"
                  BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="目标意图（Agent Desired 注册表）" FontSize="16" FontWeight="Bold"
                         Foreground="{DynamicResource BrushTextPrimary}" />
              <ItemsControl ItemsSource="{Binding DesiredIntents}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="0,6">
                      <StackPanel>
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}">
                          <Run Text="#" /><Run Text="{Binding IntentId, Mode=OneWay}" />
                          <Run Text="  " /><Run Text="{Binding ProductId, Mode=OneWay}" />
                          <Run Text="  · " /><Run Text="{Binding DesiredState, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="{DynamicResource BrushTextSecondary}">
                          <Run Text="绑定 " /><Run Text="{Binding Binding, Mode=OneWay}" />
                          <Run Text=" · 范围 " /><Run Text="{Binding Scope, Mode=OneWay}" />
                          <Run Text=" · 复用 " /><Run Text="{Binding Reapply, Mode=OneWay}" />
                        </TextBlock>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Background="{DynamicResource BrushCardBackground}" BorderBrush="{DynamicResource BrushBorder}"
                  BorderThickness="1" CornerRadius="8" Padding="14">
            <StackPanel>
              <TextBlock Text="下发产品指令" FontSize="16" FontWeight="Bold"
                         Foreground="{DynamicResource BrushTextPrimary}" />
              <TextBlock Text="选择产品" Margin="0,10,0,2" Foreground="{DynamicResource BrushTextSecondary}" />
              <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                        DisplayMemberPath="DisplayName" />
              <TextBlock Text="产品 ID" Margin="0,10,0,2" Foreground="{DynamicResource BrushTextSecondary}" />
              <TextBox Text="{Binding ProductIdText, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Text="数量参数（无参数产品可忽略）" Margin="0,10,0,2" Foreground="{DynamicResource BrushTextSecondary}" />
              <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" />
              <Button Content="提交产品指令" Command="{Binding SubmitCommand}" Style="{DynamicResource PrimaryButton}"
                      HorizontalAlignment="Left" Margin="0,14,0,0" Padding="18,8" />
              <Button Content="写入产品策略（预设）" Command="{Binding ApplyDurablePolicyCommand}"
                      Style="{DynamicResource CompactButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="14,6" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource BrushCardBackground}" BorderBrush="{DynamicResource BrushBorder}"
                  BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,0">
            <StackPanel>
              <DockPanel>
                <TextBlock Text="分层结果" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource BrushTextPrimary}" />
                <Border DockPanel.Dock="Right" CornerRadius="8" Padding="8,2"
                        Background="{DynamicResource BrushCardBackground}">
                  <TextBlock Text="{Binding ResultClassificationLabel}" FontWeight="SemiBold"
                             Foreground="{DynamicResource BrushTextPrimary}" />
                </Border>
              </DockPanel>
              <TextBox Text="{Binding ResultDetails, Mode=OneWay}" Margin="0,8,0,0" MinHeight="140" IsReadOnly="True"
                       TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
