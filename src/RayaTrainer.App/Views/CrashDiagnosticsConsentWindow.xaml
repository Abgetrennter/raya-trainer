<Window x:Class="RayaTrainer.App.Views.CrashDiagnosticsConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title, Mode=OneWay}"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BrushWindowBackground}">
  <DockPanel Margin="20">
    <TextBlock DockPanel.Dock="Top" Text="{Binding Heading, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
               Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,12" TextWrapping="Wrap" />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{Binding ConfirmText, Mode=OneWay}"
              Style="{DynamicResource PrimaryButton}" Margin="0,0,8,0" Click="OnConfirm" />
      <Button Content="{Binding CancelText, Mode=OneWay}" Click="OnCancel" IsCancel="True" />
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource BrushCardBackground}"
            BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1"
            Padding="12" CornerRadius="6" Margin="0,16,0,0">
      <TextBlock Text="{Binding Detail, Mode=OneWay}" TextWrapping="Wrap" FontSize="12"
                 Foreground="{DynamicResource BrushTextSecondary}" />
    </Border>
    <TextBlock Text="{Binding Body, Mode=OneWay}" TextWrapping="Wrap" FontSize="12"
               Foreground="{DynamicResource BrushTextSecondary}" />
  </DockPanel>
</Window>
