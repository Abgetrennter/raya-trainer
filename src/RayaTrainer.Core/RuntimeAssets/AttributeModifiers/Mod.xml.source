  <!-- Test-only stacking gate probe: proves the ascension reapply gate's StackingLimit>1
       fail-closed branch. Value 1.25 sits outside the UI bit-weight ladders (additive 1+w /
       negative binary fractions / SPEED powers of two), so no product path can resolve it.
       Never wire this template into a product. -->
  <AttributeModifier id="Atlas_StackingGateProbe" Category="WEAPON" StackingLimit="2">
    <Modifier Type="DAMAGE_MULT" Value="25%" />
  </AttributeModifier>
