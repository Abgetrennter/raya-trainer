{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rayatrainer.local/asset-manifest.schema.json",
  "title": "AttributeModifier Runtime Asset Manifest",
  "description": "Private versioned catalog of the bundled AttributeModifier asset streams and templates. Drift is guarded by RuntimeAssetCatalogTests.",
  "type": "object",
  "required": ["schemaVersion", "packageVersion", "streams", "attributeModifierTypeId", "attributeModifierTypeHash", "templates", "compatibilityContract", "officialIdBlacklist"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 2 },
    "packageVersion": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string" },
    "streams": {
      "type": "object",
      "required": ["manifest", "bin", "relo", "imp"],
      "additionalProperties": false,
      "properties": {
        "manifest": { "$ref": "#/definitions/stream" },
        "bin": { "$ref": "#/definitions/stream" },
        "relo": { "$ref": "#/definitions/stream" },
        "imp": { "$ref": "#/definitions/stream" }
      }
    },
    "uprisingStreams": {
      "type": "object",
      "description": "Game 7 (Uprising) variant streams: same AttributeModifier data body under Uprising v7 stream headers. Generated by the Game 6 pipeline plus RA3-Uprising-Converter; hashes recomputed by scripts/build-runtime-assets.ps1.",
      "required": ["manifest", "bin", "relo", "imp"],
      "additionalProperties": false,
      "properties": {
        "manifest": { "$ref": "#/definitions/stream" },
        "bin": { "$ref": "#/definitions/stream" },
        "relo": { "$ref": "#/definitions/stream" },
        "imp": { "$ref": "#/definitions/stream" }
      }
    },
    "attributeModifierTypeId": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{8}$" },
    "attributeModifierTypeHash": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{8}$" },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/template" }
    },
    "compatibilityContract": {
      "type": "object",
      "required": ["frozenInstanceIds", "saveDependency", "noHotUnload"],
      "additionalProperties": false,
      "properties": {
        "frozenInstanceIds": { "type": "string" },
        "saveDependency": { "type": "string" },
        "noHotUnload": { "type": "string" }
      }
    },
    "officialIdBlacklist": {
      "type": "array",
      "description": "Official inheritance-chain InstanceIds that must never enter the bundle (Lab build.ps1 denylist). Mirrored here as defense-in-depth; RuntimeAssetCatalogTests asserts each is absent from templates.",
      "items": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{8}$" }
    }
  },
  "definitions": {
    "stream": {
      "type": "object",
      "required": ["fileName", "sha256Upper"],
      "additionalProperties": false,
      "properties": {
        "fileName": { "type": "string", "enum": ["mod.manifest", "mod.bin", "mod.relo", "mod.imp"] },
        "sha256Upper": { "type": "string", "pattern": "^[0-9A-F]{64}$" }
      }
    },
    "template": {
      "type": "object",
      "required": ["name", "instanceId", "attributeType", "attributeTypeName", "value", "valueBitsUpper", "stackingLimit", "category", "batch", "purpose"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "instanceId": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{8}$" },
        "attributeType": { "type": "integer", "minimum": 0 },
        "attributeTypeName": { "type": "string", "minLength": 1 },
        "value": { "type": "number" },
        "valueBitsUpper": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{8}$" },
        "stackingLimit": { "type": "integer", "minimum": 1 },
        "category": { "type": "string" },
        "batch": { "type": "string" },
        "bitWeightIncrement": { "type": ["number", "null"] },
        "purpose": { "type": "string" },
        "templateType": {
          "type": "string",
          "enum": ["attributeModifier", "gameObject", "objectCreationList"],
          "description": "schemaVersion 2: distinguishes the merged GameObject/OCL set from AttributeModifier entries. Optional; absent means attributeModifier."
        },
        "typeId": {
          "type": "string",
          "pattern": "^0x[0-9A-Fa-f]{8}$",
          "description": "schemaVersion 2: engine asset TypeId. AttributeModifier entries reuse AttributeModifierTypeId (0xC5E07887); GameObject entries carry the ThingTemplate TypeId (0x942FFF2D)."
        }
      }
    }
  }
}
